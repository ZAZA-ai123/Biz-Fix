# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
# Required. Create a Clerk app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# ─── Database (Upstash Redis) ────────────────────────────────────────────────
# Required. Create a Redis DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── RAG / Vector store (Upstash Vector) ─────────────────────────────────────
# Required for /api/rag/ingest and quote retrieval. Same dashboard, separate index.
UPSTASH_VECTOR_REST_URL=https://xxx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xxx

# ─── LLMs ────────────────────────────────────────────────────────────────────
# Required: Groq powers planning + ask-mode chat.
GROQ_API_KEY=gsk_xxx

# Required: Gemini powers quote structuring + embeddings.
GEMINI_API_KEY=xxx
# Optional override; defaults to gemini-1.5-flash.
GEMINI_MODEL=gemini-1.5-flash

# ─── Optional research helpers ───────────────────────────────────────────────
# Web search for competitor / news enrichment. Safe to leave blank.
TAVILY_API_KEY=
NEWS_API_KEY=
HF_TOKEN=
